{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bha.dev/schemas/analysis-v0.1.0.json",
  "title": "Build Hotspot Analyzer analysis document",
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "document_type",
    "schema_version",
    "bha_version",
    "generated_at",
    "analysis_time",
    "performance",
    "summary",
    "cache_distribution",
    "build_session",
    "linker",
    "targets",
    "modules",
    "process_resources"
  ],
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "$id": {"type": "string", "format": "uri"},
    "document_type": {"const": "bha-analysis"},
    "schema_version": {"const": "0.1.0"},
    "bha_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "analysis_time": {"type": "string", "format": "date-time"},
    "performance": {
      "type": "object",
      "required": [
        "total_build_time_ms",
        "sequential_time_ms",
        "parallel_time_ms",
        "parallelism_efficiency",
        "total_files",
        "slowest_file_count",
        "avg_file_time_ms",
        "median_file_time_ms",
        "p90_file_time_ms",
        "p99_file_time_ms",
        "memory",
        "slowest_files"
      ],
      "properties": {
        "total_build_time_ms": {"type": ["number", "null"]},
        "sequential_time_ms": {"type": ["number", "null"]},
        "parallel_time_ms": {"type": ["number", "null"]},
        "parallelism_efficiency": {"type": ["number", "null"]},
        "total_files": {"type": "integer", "minimum": 0},
        "slowest_file_count": {"type": "integer", "minimum": 0},
        "avg_file_time_ms": {"type": ["number", "null"]},
        "median_file_time_ms": {"type": ["number", "null"]},
        "p90_file_time_ms": {"type": ["number", "null"]},
        "p99_file_time_ms": {"type": ["number", "null"]},
        "memory": {"type": "object"},
        "slowest_files": {"type": "array"}
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["total_files", "total_compile_time_ms", "analysis_duration_ms", "metric_capabilities"],
      "properties": {
        "total_files": {"type": "integer", "minimum": 0},
        "total_compile_time_ms": {"type": ["number", "null"]},
        "analysis_duration_ms": {"type": ["number", "null"]},
        "metric_capabilities": {"type": "array"}
      },
      "additionalProperties": true
    },
    "files": {"type": "array"},
    "dependencies": {"type": "object"},
    "templates": {"type": "object"},
    "symbols": {"type": "object"},
    "suggestions": {"type": "array"},
    "cache_distribution": {"type": "object"},
    "build_session": {"type": "object"},
    "linker": {"type": "object"},
    "targets": {"type": "object"},
    "modules": {"type": "object"},
    "process_resources": {"type": "object"}
  },
  "additionalProperties": true
}
